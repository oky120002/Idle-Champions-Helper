{
  "name": "idle-champions-helper",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@11.23.0",
  "type": "module",
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . && tsx scripts/check-colors.ts && tsx scripts/check-color-contrast.ts",
    "lint:contrast": "tsx scripts/check-color-contrast.ts",
    "typecheck": "tsc -b --pretty false",
    "test": "pnpm run typecheck && vitest",
    "test:run": "pnpm run typecheck && vitest run",
    "test:unit": "pnpm run typecheck && vitest run --project unit",
    "test:component": "pnpm run typecheck && vitest run --project component",
    "test:data": "pnpm run typecheck && vitest run scripts/ && pnpm run data:validate-schema",
    "test:simulator": "pnpm run typecheck && vitest run src/domain/simulator/ src/domain/planner/ src/domain/buffs/ scripts/simulator/smoke.test.ts && pnpm run data:signal-coverage",
    "pretest:e2e": "pnpm run build && pnpm run privacy:scan-build",
    "test:e2e": "playwright test",
    "test:regression": "pnpm run lint && pnpm run test:run && pnpm run test:data && pnpm run test:e2e",
    "playwright:install": "playwright install chromium",
    "preview": "vite preview",
    "preview:pages": "tsx scripts/serve-github-pages-preview.ts",
    "data:fetch": "tsx scripts/fetch-idle-champions-definitions.ts",
    "data:normalize": "tsx scripts/normalize-idle-champions-definitions.ts",
    "data:portraits": "tsx scripts/sync-idle-champions-portraits.ts",
    "data:console-portraits": "tsx scripts/sync-idle-champions-console-portraits.ts",
    "data:specialization-graphics": "tsx scripts/sync-idle-champions-specialization-graphics.ts",
    "data:equipment-icons": "tsx scripts/sync-idle-champions-equipment-icons.ts",
    "data:illustrations": "tsx scripts/sync-idle-champions-illustrations.ts",
    "data:animations": "tsx scripts/sync-idle-champions-animations.ts",
    "data:animation-audit": "tsx scripts/audit-idle-champions-animations.ts",
    "data:pets": "tsx scripts/sync-idle-champions-pets.ts",
    "data:official": "tsx scripts/build-idle-champions-data.ts",
    "data:search": "tsx scripts/data/build-search-index.ts",
    "data:signal-coverage": "tsx scripts/data/signal-coverage.ts",
    "data:validate-schema": "tsx scripts/validate-data-schemas.ts",
    "simulate": "tsx scripts/simulator/simulate.ts",
    "simulate:benchmark": "tsx scripts/simulator/benchmark.ts",
    "private-user-data:fetch": "tsx scripts/private-user-data/fetch-user-profile-payloads.ts",
    "privacy:scan": "tsx scripts/private-user-data/privacy-scan.ts",
    "privacy:scan-build": "tsx scripts/private-user-data/production-boundary-scan.ts"
  },
  "dependencies": {
    "decimal.js": "^10.6.0",
    "fflate": "^0.8.3",
    "lucide-react": "^1.25.0",
    "minisearch": "^7.2.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@napi-rs/canvas": "^1.0.2",
    "@playwright/test": "^1.61.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/eslint-plugin": "^1.6.25",
    "eslint": "^9.39.5",
    "eslint-import-resolver-typescript": "^4.4.5",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "eslint-plugin-sonarjs": "^4.2.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.64.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10",
    "zod": "^4.3.6"
  }
}
